---
import { version, versioned, jsonScript, starts } from '../data/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import Navigation from '../components/Navigation.astro';
import head from '../data/start-head.html?raw';
import css from '../styles/start.css?raw';
import pageScript from '../scripts/start.js?raw';
---
<SiteLayout head={versioned(head)} css={css}>

  <div class="grid-bg" aria-hidden="true"></div>

  <Navigation page="start" />

  <main>
    <header class="lead">
      <div>
        <p class="lead-label" data-en="Start with words, Mermaid, or code" data-zh="從描述、Mermaid 或代碼開始">Start with words, Mermaid, or code</p>
        <h1><span data-en="Describe it." data-zh="直接說，">Describe it.</span><span class="title-gap" aria-hidden="true"> </span><em data-en="Archify maps it." data-zh="Archify 就能畫。">Archify maps it.</em></h1>
      </div>
      <div>
        <p class="lead-copy" data-en="No repository is required. Describe a system or flow in a normal agent chat and Archify will turn it into a checked, interactive diagram. If code exists, the same skill can inspect it for evidence." data-zh="不需要綁定代碼庫。在任意 Agent 對話裡用自然語言描述系統或流程，Archify 就會把它變成經過校驗的交互圖；如果有代碼，也可以再讓它讀取倉庫作為證據。">No repository is required. Describe a system or flow in a normal agent chat and Archify will turn it into a checked, interactive diagram. If code exists, the same skill can inspect it for evidence.</p>
        <div class="trust-line" data-en="Your description is enough to make the first diagram." data-zh="只有一段描述，也足夠畫出第一張圖。">Your description is enough to make the first diagram.</div>
      </div>
    </header>

    <section class="type-shell" aria-labelledby="type-label">
      <p class="type-label"><span data-en="Choose how to start" data-zh="選擇如何開始">Choose how to start</span><strong data-en="Repository optional" data-zh="代碼庫可選">Repository optional</strong></p>
      <div class="input-paths" role="tablist" aria-label="Input source">
        <button class="input-path" type="button" role="tab" data-input="description"><strong data-en="Just describe it" data-zh="直接描述">直接描述</strong><span data-en="Start in any chat. No files or repository needed." data-zh="在任意對話裡開始，不需要文件或代碼庫。">Start in any chat. No files or repository needed.</span></button>
        <button class="input-path" type="button" role="tab" data-input="repository"><strong data-en="Use a repository" data-zh="從代碼庫開始">Use a repository</strong><span data-en="Let the agent inspect code when source evidence matters." data-zh="需要源碼證據時，再讓 Agent 檢查代碼。">Let the agent inspect code when source evidence matters.</span></button>
      </div>
      <p class="type-label" id="type-label"><span data-en="Choose the question shape" data-zh="選擇問題形態">Choose the question shape</span><strong data-en="5 typed renderers" data-zh="5 種類型化渲染器">5 typed renderers</strong></p>
      <div class="type-tabs" role="tablist" aria-label="Diagram type">
        <button class="type-tab" type="button" role="tab" data-type="architecture" data-en="Architecture" data-zh="架構圖">Architecture</button>
        <button class="type-tab" type="button" role="tab" data-type="workflow" data-en="Workflow" data-zh="工作流">Workflow</button>
        <button class="type-tab" type="button" role="tab" data-type="sequence" data-en="Sequence" data-zh="時序圖">Sequence</button>
        <button class="type-tab" type="button" role="tab" data-type="dataflow" data-en="Data flow" data-zh="數據流">Data flow</button>
        <button class="type-tab" type="button" role="tab" data-type="lifecycle" data-en="Lifecycle" data-zh="生命周期">Lifecycle</button>
      </div>
    </section>

    <section class="workbench" aria-label="Archify quick start">
      <article class="panel" id="install">
        <div class="panel-kicker"><b>01</b><span data-en="Install the skill" data-zh="安裝 Skill">Install the skill</span></div>
        <h2 data-en="Keep the tool local." data-zh="讓工具留在本地。">Keep the tool local.</h2>
        <p class="panel-intro" data-en="Choose Cursor, Codex, Claude Code, or OpenCode. The switcher gives each one the same checked Skill and zero-dependency renderers—no vendor-specific fork." data-zh="選擇 Cursor、Codex、Claude Code 或 OpenCode。切換器為每個 Agent 提供同一份經過檢查的 Skill 與零依賴渲染器，不維護廠商專屬分叉。">Choose Cursor, Codex, Claude Code, or OpenCode. The switcher gives each one the same checked Skill and zero-dependency renderers—no vendor-specific fork.</p>

        <div class="agent-picker">
          <p class="agent-picker-head"><span data-en="Choose your coding agent" data-zh="選擇你的編碼 Agent">Choose your coding agent</span><strong id="agent-state">Codex · same Skill</strong></p>
          <div class="agent-tabs" role="tablist" aria-label="Coding agent">
            <button class="agent-tab" type="button" role="tab" data-agent="cursor">Cursor</button>
            <button class="agent-tab" type="button" role="tab" data-agent="codex">Codex</button>
            <button class="agent-tab" type="button" role="tab" data-agent="claude-code">Claude Code</button>
            <button class="agent-tab" type="button" role="tab" data-agent="opencode">OpenCode</button>
          </div>
        </div>

        <div class="command-block">
          <div class="command-bar"><span data-en="Global install" data-zh="全局安裝">Global install</span><button class="copy-button" type="button" data-copy-source="install-command" data-en="Copy" data-zh="複製">Copy</button></div>
          <pre id="install-command">npx -y skills add tt-a1i/archify --skill archify --agent codex --global --copy --yes</pre>
        </div>
        <div class="command-block">
          <div class="command-bar"><span data-en="This repository only" data-zh="僅安裝到當前倉庫">This repository only</span><button class="copy-button" type="button" data-copy-source="project-command" data-en="Copy" data-zh="複製">Copy</button></div>
          <pre id="project-command">npx -y skills add tt-a1i/archify --skill archify --agent codex --copy --yes</pre>
        </div>
        <p class="secondary-note" data-en="Raven is supported through a manual ZIP installation, not a generated agent-switcher command. Extract archify.zip into ~/.raven/workspace/skills, which yields ~/.raven/workspace/skills/archify." data-zh="Raven 採用 ZIP 手動安裝，不使用 Agent 切換器生成命令。將 archify.zip 解壓到 ~/.raven/workspace/skills，解壓後會得到 ~/.raven/workspace/skills/archify。">Raven is supported through a manual ZIP installation, not a generated agent-switcher command. Extract archify.zip into ~/.raven/workspace/skills, which yields ~/.raven/workspace/skills/archify.</p>
        <p class="secondary-note" data-en="The Start link carries only your agent, language, diagram type, input mode, and a coarse source label. Journey events stay in this browser session and are never sent by Archify. No repository path, title, node, relationship, or source JSON is recorded." data-zh="Start 連結只攜帶 Agent、語言、圖表類型、輸入模式和粗粒度來源標籤。轉化步驟只保存在當前瀏覽器會話中，Archify 不會發送這些數據，也不會記錄倉庫路徑、標題、節點、關係或源 JSON。">The Start link carries only your agent, language, diagram type, input mode, and a coarse source label. Journey events stay in this browser session and are never sent by Archify. No repository path, title, node, relationship, or source JSON is recorded.</p>
      </article>

      <article class="panel" aria-live="polite">
        <div class="panel-kicker"><b>02</b><span data-en="Ask one bounded question" data-zh="只問一個有邊界的問題">Ask one bounded question</span></div>
        <h2 id="recipe-title">System overview</h2>
        <p class="question" id="recipe-question"></p>
        <ul class="include-list" id="include-list" aria-label="Required evidence"></ul>
        <p class="prompt-box" id="recipe-prompt"></p>
        <div class="actions">
          <button class="action action-primary" id="copy-starter" type="button" data-en="Copy install + prompt" data-zh="複製安裝命令 + 提示詞">Copy install + prompt</button>
          <button class="action" id="copy-prompt" type="button" data-en="Prompt only" data-zh="僅複製提示詞">Prompt only</button>
          <a class="action" id="proof-link" href="gallery.html" data-en="Open verified proof ↗" data-zh="打開驗證成品 ↗">Open verified proof ↗</a>
          <a class="action" href="guide.html" data-en="Need another recipe?" data-zh="需要其他配方？">Need another recipe?</a>
        </div>
        <p class="proof-meta" id="proof-meta"></p>
      </article>
    </section>

    <footer class="page-footer">
      <span data-en={`Archify v${version} · development · self-contained HTML · typed JSON source`} data-zh={`Archify v${version} · 開發版 · 獨立 HTML · 類型化 JSON 源`}>Archify v{version} · development · self-contained HTML · typed JSON source</span>
      <span id="copy-status" role="status" aria-live="polite"></span>
      <a href="https://github.com/tt-a1i/archify" data-en="View source on GitHub ↗" data-zh="在 GitHub 查看源碼 ↗">View source on GitHub ↗</a>
    </footer>
  </main>

  <script is:inline id="start-data" type="application/json" set:html={jsonScript(starts)}></script>
  <script is:inline src="assets/site-language.js"></script>
  <script is:inline set:html={versioned(pageScript)}></script>

</SiteLayout>
